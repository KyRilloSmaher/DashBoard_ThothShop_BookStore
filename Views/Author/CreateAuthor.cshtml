@using ThothStore_DashBoard.Models.Enums
@model ThothStore_DashBoard.Models.Author.CreateAuthorRequest

<style>
    body {
        background-color: #000; /* black background */
        color: gold; /* gold text */
    }

    .form-container {
        margin-top: 50px;
        background-color: #111; /* dark black-ish form background */
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 15px gold;
    }

    .form-control {
        background-color: #222;
        border: 1px solid gold;
        color: gold;
    }

        .form-control::placeholder {
            color: #ccc;
        }

    label {
        font-weight: bold;
        color: gold;
    }

    .btn-gold {
        background-color: gold;
        color: black;
        border: none;
        margin-top: 10px;
    }

        .btn-gold:hover {
            background-color: #ffd700;
            color: black;
        }

    .validation-summary-errors {
        color: red;
    }
</style>

<div class="container form-container">
    <h2 class="text-center">Create New Author</h2>

    <form asp-action="Create" asp-controller="Author" method="post">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" placeholder="Enter Author Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Bio"></label>
            <input asp-for="Bio" class="form-control" placeholder="Enter Author Bio" />
            <span asp-validation-for="Bio" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Gender"></label>
            <select asp-for="Gender" asp-items="@(new SelectList(ViewBag.Genders,"Value","Text"))">
            </select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Nationality"></label>
            <select asp-for="Nationality" asp-items="@(new SelectList(ViewBag.Nationalities,"Value","Text"))">
                 
                </select>
            <span asp-validation-for="Nationality" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="DateOfBirth"></label>
            <input asp-for="DateOfBirth" class="form-control"/>
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>

        <div class="form-group text-center">
            <button type="submit" class="btn btn-gold btn-lg">Create Author</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

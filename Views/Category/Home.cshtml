@model IEnumerable<ThothStore_DashBoard.Models.Category.CategoryResposnse>

<div class="container mt-5">

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card card-custom text-center p-4">
                <h4>Total Categories</h4>
                <h2>@ViewBag.Count</h2>
                <a asp-action="OpenCreateCategoryPage" asp-controller="Category" class="btn btn-gold mt-3">Create New Category</a>
            </div>
        </div>

        <!-- Search Section -->
        <div class="col-md-8">
            <div class="card card-custom p-4">
                <h4 class="text-center">Search Categories</h4>
                <form method="get" asp-action="Search" asp-controller="Category" class="d-flex mt-3">
                    <input type="text" name="term" class="form-control custom-search me-2" placeholder="Enter category name..." />
                    <button type="submit" class="btn btn-gold me-2">Search</button>
                    <a asp-action="Home" asp-controller="Category" class="btn custom-secondary">Reset</a>
                </form>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <h3 class="mb-3">Categories List</h3>

            <table class="table">
                <thead>
                    <tr>
                        <th>Category Id</th>
                        <th>Category Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.Id</td>
                            <td>@category.Name</td>
                            <td>
                                <a asp-controller="Category" asp-action="OpenUpdateCategoryPage" asp-route-id="@category.Id" class="btn btn-sm btn-gold mr-2">Update</a>
                                <form asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" method="post" class="form-inline">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this category?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
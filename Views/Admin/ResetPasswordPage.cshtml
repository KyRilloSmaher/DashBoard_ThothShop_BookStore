@model ThothStore_DashBoard.Models.Admin.ResetPasswordRequest
<style>
    body {
        background-color: #000; /* black background */
        color: gold; /* gold text */
    }

    .form-container {
        margin-top: 50px;
        background-color: #111; /* dark black-ish form background */
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 15px gold;
    }

    .form-control {
        background-color: #222;
        border: 1px solid gold;
        color: gold;
    }

        .form-control::placeholder {
            color: #ccc;
        }

    label {
        font-weight: bold;
        color: gold;
    }

    .btn-gold {
        background-color: gold;
        color: black;
        border: none;
        margin-top: 10px;
    }

        .btn-gold:hover {
            background-color: #ffd700;
            color: black;
        }

    .validation-summary-errors {
        color: red;
    }
</style>
<div class="container form-container">
    <h2 class="text-center"> Reset Password </h2>
    <form asp-action="ConfirmResetPassword" asp-controller="Admin" method="post">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control"/>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>  
        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="form-group text-center">
            <button type="submit" class="btn btn-gold btn-lg">Update</button>
        </div>
    </form>
</div>

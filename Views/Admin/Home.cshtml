@model IEnumerable<ThothStore_DashBoard.Models.Admin.AdminResponse>

<style>
    body {
        background-color: #000;
        color: gold;
    }

    .card-custom {
        background-color: #111;
        border: 1px solid gold;
        box-shadow: 0 0 10px gold;
    }



    .btn-gold {
        background-color: gold;
        color: black;
        font-weight: bold;
        border: none;
    }

        .btn-gold:hover {
            background-color: #ffd700;
            color: black;
        }

    .btn-danger {
        background-color: #ff4d4d;
        color: white;
        border: none;
    }

        .btn-danger:hover {
            background-color: #e60000;
            color: white;
        }

    .table th, .table td {
        border: 1px solid gold;
        padding: 10px;
        text-align: center;
    }

    .table th {
        background-color: #222;
    }

    .table {
        background-color: #111;
        color: gold;
    }


    .pagination a {
        color: gold;
        background-color: #222;
        border: 1px solid gold;
        padding: 5px 10px;
        margin: 2px;
    }

    .pagination a.active {
        background-color: gold;
        color: black;
    }
</style>

<div class="container mt-5">

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card card-custom text-center p-4">
                <h4>Total Admins</h4>
                <h2>@Model.Count()</h2>
                <a asp-action="OpenCreateForm" asp-controller="Admin" class="btn btn-gold mt-3">Create New Admin</a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <h3 class="mb-3">Admins List</h3>

            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>UserName</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Phone Number</th>
                        <th>Actions</th> 
                    </tr>
                </thead>
                <tbody>
                    @foreach (var admin in Model)
                    {
                        <tr>
                            <td>@admin.Id</td>
                            <td>@admin.UserName</td>
                            <td>@admin.Email</td>
                            <td>@admin.Address</td>
                            <td>@admin.PhoneNumber</td>
                            <td>
                                <a asp-controller="Admin" asp-action="OpenUpdateForm" asp-route-id="@admin.Id" class="btn btn-sm btn-gold mr-2">Update</a>
                                <a asp-controller="Admin" asp-action="SendResetPasswordCode" asp-route-email="@admin.Email" class=" btn btn-sm btn-success">Reset password</a>

                                <form asp-controller="Admin"  asp-action="Delete" asp-route-id="@admin.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this admin?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>


           <!--
                     <nav class="text-center">
                         <ul class="pagination justify-content-center">
                              for (int i = 1; i <= Model.TotalPages; i++)
                              {
                                  <li class="page-item (i == Model.CurrentPage ? "active" : "")">
                                      <a class="page-link" asp-action="Index" asp-route-page="i">i</a>
                                  </li>
                              }
                         </ul>
                 
                     </nav>
              -->
        </div>
    </div>

</div>


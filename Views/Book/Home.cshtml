@model ThothStore_DashBoard.Models.Book.VM.BookPaginetedListResponse
@{
    ViewData["Title"] = "Books Management";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Books Management</h1>
        <p class="text-muted">Manage your book inventory and catalog</p>
    </div>
    <a asp-action="OpenCreateBookPage" asp-controller="Book" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>
        Add New Book
    </a>
</div>

<!-- Statistics Cards -->
<div class="dashboard-cards mb-4">
    <div class="stat-card primary">
        <div class="stat-header">
            <span class="stat-title">Total Books</span>
            <div class="stat-icon">
                <i class="fas fa-book"></i>
            </div>
        </div>
        <div class="stat-value">@Model.TotalCount</div>
        <div class="stat-change positive">
            <i class="fas fa-arrow-up"></i>
            <span>Active in catalog</span>
        </div>
    </div>

    <div class="stat-card warning">
        <div class="stat-header">
            <span class="stat-title">Low Stock</span>
            <div class="stat-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
        </div>
        <div class="stat-value">@Model.OutofStockBooks.Count(b => b.Stock < 5)</div>
        <div class="stat-change negative">
            <i class="fas fa-arrow-down"></i>
            <span>Need restocking</span>
        </div>
    </div>

    <div class="stat-card danger">
        <div class="stat-header">
            <span class="stat-title">Out of Stock</span>
            <div class="stat-icon">
                <i class="fas fa-times-circle"></i>
            </div>
        </div>
        <div class="stat-value">@Model.OutofStockBooks.Count(b => b.Stock == 0)</div>
        <div class="stat-change negative">
            <i class="fas fa-arrow-down"></i>
            <span>Unavailable</span>
        </div>
    </div>
</div>

<!-- Search and Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Search" asp-controller="Book" class="row g-3">
            <div class="col-md-8">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" 
                           name="term" 
                           class="form-control" 
                           placeholder="Search books by title, author, or category..."
                           value="@Context.Request.Query["term"]">
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search me-2"></i>
                        Search
                    </button>
                    <a asp-action="Home" asp-controller="Book" class="btn btn-secondary">
                        <i class="fas fa-undo me-2"></i>
                        Reset
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Books Table -->
<div class="data-table">
    <div class="data-table-header">
        <h3 class="data-table-title">
            <i class="fas fa-list me-2"></i>
            Books Catalog
        </h3>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary">@Model.books.Count() items</span>
        </div>
    </div>
    <div class="data-table-body">
        <table class="table">
            <thead>
                <tr>
                    <th>Book Title</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.books)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="me-3">
                                    <i class="fas fa-book text-primary fa-lg"></i>
                                </div>
                                <div>
                                    <strong>@book.Title</strong>
                                    @if (!string.IsNullOrEmpty(book.Description))
                                    {
                                        <br>
                                        <small class="text-muted">@book.Description.Substring(0, Math.Min(50, book.Description.Length))...</small>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            <strong>$@book.Price.ToString("F2")</strong>
                        </td>
                        <td>
                            @if (book.Stock > 10)
                            {
                                <span class="badge bg-success">@book.Stock in stock</span>
                            }
                            else if (book.Stock > 0)
                            {
                                <span class="badge bg-warning">@book.Stock in stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of stock</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-secondary">@book.CategoryName</span>
                        </td>
                        <td>
                            @if (book.Stock > 0)
                            {
                                <span class="status-badge completed">Available</span>
                            }
                            else
                            {
                                <span class="status-badge cancelled">Unavailable</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-controller="Book" 
                                   asp-action="OpenUpdateBookPage" 
                                   asp-route-id="@book.Id" 
                                   class="btn btn-sm btn-outline-primary"
                                   title="Edit Book">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" 
                                        class="btn btn-sm btn-outline-danger" 
                                        onclick="deleteBook('@book.Id', '@book.Title')"
                                        title="Delete Book">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Home" asp-route-PageNumber="@(Model.CurrentPage - 1)" asp-route-PageSize="10">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
            }
            
            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Home" asp-route-PageNumber="@i" asp-route-PageSize="10">@i</a>
                </li>
            }
            
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Home" asp-route-PageNumber="@(Model.CurrentPage + 1)" asp-route-PageSize="10">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Low Stock Alert -->
@if (Model.OutofStockBooks.Any(b => b.Stock < 5))
{
    <div class="card mt-4 border-warning">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Low Stock Alert
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Book Title</th>
                            <th>Current Stock</th>
                            <th>Category</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.OutofStockBooks.Where(b => b.Stock < 5))
                        {
                            <tr>
                                <td>
                                    <strong>@book.Title</strong>
                                </td>
                                <td>
                                    @if (book.Stock == 0)
                                    {
                                        <span class="badge bg-danger">Out of stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">@book.Stock remaining</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@book.CategoryName</span>
                                </td>
                                <td>
                                    <a asp-controller="Book" 
                                       asp-action="OpenUpdateBookPage" 
                                       asp-route-id="@book.Id" 
                                       class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit me-1"></i>
                                        Update Stock
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the book "<strong id="bookTitle"></strong>"?</p>
                <p class="text-muted">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" class="form-inline">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>
                        Delete Book
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteBook(bookId, bookTitle) {
            document.getElementById('bookTitle').textContent = bookTitle;
            document.getElementById('deleteForm').action = `/Book/Delete/${bookId}`;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}